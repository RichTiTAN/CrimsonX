<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:CrimsonX.Behaviors"
             x:Class="CrimsonX.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <!-- Theme Colors (Default to Crimson) -->
        <SolidColorBrush x:Key="ThemeAccent" Color="#B82E42"/>
        <SolidColorBrush x:Key="ThemeMutedBrush" Color="#40B82E42"/>
        <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#80B82E42"/>
        <SolidColorBrush x:Key="ThemeAccentPointerOver" Color="#D13A51"/>
        <SolidColorBrush x:Key="ThemeAccentPressed" Color="#932535"/>
        <Color x:Key="ThemeGlow">#FFE64A62</Color>

        <!-- Success (connected) -->
        <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#38A169"/>
        <SolidColorBrush x:Key="ThemeSuccessPointerOverBrush" Color="#48BB78"/>
        <SolidColorBrush x:Key="ThemeSuccessGlowBrush" Color="#68D391"/>

        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#B82E42"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D13A51"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#932535"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent"/>
        
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#B82E42"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#D13A51"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#932535"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#B82E42"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D13A51"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#932535"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelectionBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="#A0AEC0"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
        </Style>
        
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentPointerOver}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentPointerOver}" />
        </Style>
        <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentPressed}" />
        </Style>

        <Style Selector="Control">
            <Setter Property="ToolTip.ShowDelay" Value="400"/>
        </Style>

        <!-- Tooltips now carry the sidebar's item names, so they get the app's own card: the toast palette, our
             own template (so the look can't drift with the theme), and room for the longer descriptions used
             elsewhere. -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#F20E1014"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MaxWidth" Value="340"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BoxShadow="0 6 18 -4 #80000000">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          MaxWidth="{TemplateBinding MaxWidth}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          TextBlock.LetterSpacing="{TemplateBinding LetterSpacing}"
                                          TextBlock.TextWrapping="Wrap"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="(behaviors:SmoothScrollBehavior.IsEnabled)" Value="True"/>
            <Setter Property="BringIntoViewOnFocusChange" Value="False"/>
        </Style>
    
        <Style Selector="Border.hoverBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.hoverBox:pointerover">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>

        <!-- ── Connect button box: shared by the home tab and the Apps & Games strip ── -->

        <Style Selector="Border.floatBox">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BoxShadow" Value="0 0 26 6 #E6000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.floatBox:pointerover">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>

        <Style Selector="Border.connectBox">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 0 26 6 #E6000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.connectBox:pointerover">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>
        <!-- The box's button is a real Button, so Fluent paints its own hover and press fill into the content
             presenter and the whole box lights up. Neutralised here, so hovering only turns the border white
             (the rule above) and press feedback stays with panConnectPress, which is code driven. -->
        <Style Selector="Border.connectBox Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.connectBox Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.connectBox.connected">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccessBrush}"/>
        </Style>
        <Style Selector="Border.connectBox.connected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccessPointerOverBrush}"/>
        </Style>

        <Style Selector="Border.shadowCarrier">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 0 26 6 #E6000000"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- The breathing ring a connect box wears while a connection is coming up (opacity is driven from
             code: ConnectPhaseUi.Breath over a 1.6 s sine). It is a separate border so the underlying
             border keeps its grey / hover / green states untouched.
             Margin="-2" in the boxes is load-bearing: the boxes carry BorderThickness=2 and no padding, so
             their content area sits 2px inside - the negative margin lifts this ring back onto the border
             band, where its 2px stroke and radius 8 line up with the box's own border exactly, so the edge
             itself reads as the thing that breathes. -->
        <Style Selector="Border.connectBreath">
            <Setter Property="BorderBrush" Value="#DD6B20"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- ── The pale-highlight pill: Home's MODE choice and the panel's ALLOW SINGLE CONFIG ──
             Lit means on. The lit fill is the same #1AFFFFFF the app already uses for a chosen option,
             and the hover is a whisper on top of it (6% white), so hovering never looks more on than on. -->
        <Style Selector="Button.pillBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pillBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>
        <Style Selector="Button.pillBtn.on">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
    </Application.Styles>
</Application>
