// TEMPLATE for AppSecrets.cs (which is gitignored).
// To build: copy this file to "AppSecrets.cs" and fill in your own values.
// This .example file is intentionally not compiled (it does not end in ".cs").

namespace CrimsonX.Services
{
    internal static class AppSecrets
    {
        // Cloudflare worker endpoints used to scrape configs (full URLs, no trailing slash).
        internal static readonly string[] WorkerUrls = new string[]
        {
            // "https://your-worker-1.workers.dev",
            // "https://your-worker-2.workers.dev",
        };

        // Bare worker domains (without scheme) used by the engine routing rules.
        internal static readonly string[] WorkerDomains = new string[]
        {
            // "your-worker-1.workers.dev",
            // "your-worker-2.workers.dev",
        };

        // AES key/IV used to encrypt the local config cache.
        // CacheKey must stay exactly 32 bytes and CacheIv exactly 16 bytes.
        // Generate fresh random values, e.g. in PowerShell:
        //   $key = -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % { [char]$_ })
        //   $iv  = -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 16 | % { [char]$_ })
        internal const string CacheKey = "YOUR_32_BYTE_CACHE_KEY_HERE_____"; // 32 bytes
        internal const string CacheIv = "YOUR_16B_IV_____";                 // 16 bytes
    }
}
