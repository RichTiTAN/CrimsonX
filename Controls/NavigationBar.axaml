<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CrimsonX.Controls"
             x:Class="CrimsonX.Controls.NavigationBar">
    <UserControl.Styles>
        <Style Selector="RadioButton.navBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#909090"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Avalonia's ToolTip.VerticalOffset defaults to 20, which pushed every card ~20px below where its
                 placement says - Right placement already centres the card on the tile. The -4 horizontal offset
                 measures from the icon (10px inside the tile) rather than from the tile's edge. -->
            <Setter Property="ToolTip.Placement" Value="Right"/>
            <Setter Property="ToolTip.HorizontalOffset" Value="11"/>
            <Setter Property="ToolTip.VerticalOffset" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        
                        <Border x:Name="ThemeAnimatedBackground" Opacity="0" ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                </Transitions>
                            </Border.Transitions>
                            <Panel>
                                <Rectangle Fill="{DynamicResource ThemeCurrentBrush}"/>
                                <Rectangle Classes="activeThemeGradient" Margin="-75" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="{DynamicResource ThemeCurrentBrush}">
                                    <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Panel>
                        </Border>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Hover State -->
        <Style Selector="RadioButton.navBtn:pointerover /template/ Border#BackgroundBorder">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="RadioButton.navBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <!-- Checked State -->
        <Style Selector="RadioButton.navBtn:checked /template/ Border#BackgroundBorder">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="RadioButton.navBtn:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        
        <!-- Checked State for Themes button -->
        <Style Selector="RadioButton.themeNavBtn:checked /template/ Border#BackgroundBorder">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="RadioButton.themeNavBtn:checked /template/ Border#ThemeAnimatedBackground">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>


        <!-- The ad/tracker blocker tile: the nav tiles' look, but a toggle - its icon turns green while it is on.
             It never joins the page group, so clicking it cannot navigate. -->
        <Style Selector="ToggleButton.railTile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#909090"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip.Placement" Value="Right"/>
            <Setter Property="ToolTip.HorizontalOffset" Value="11"/>
            <Setter Property="ToolTip.VerticalOffset" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>

                        <!-- This presenter is deliberately NOT called PART_ContentPresenter. The Fluent
                             ToggleButton theme paints its checked / hovered / pressed Background onto the
                             element with that name, and a themed square landing exactly behind the icon is
                             what used to show up whenever the blocker was turned on. The name is not a
                             template part of ToggleButton, so dropping it costs nothing and makes the tile's
                             own rounded highlight the only thing that ever fills this space.

                             HorizontalAlignment is Center (the nav tiles use Left) so the shield sits in the
                             middle of the rail: the shield's geometry is 18x21, so Uniform stretch always
                             leaves horizontal slack, and centring the box centres the glyph. -->
                        <ContentPresenter x:Name="TileContent"
                                          Content="{TemplateBinding Content}"
                                          Background="Transparent"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.railTile:pointerover /template/ Border#BackgroundBorder">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>

        <!-- Belt and braces: no state of this tile picks up a background from anywhere else. -->
        <Style Selector="ToggleButton.railTile:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.railTile:pressed">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.railTile:checked">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- While the locations overlay is open its tile wears the nav tiles' checked highlight: the same
             #33FFFFFF fill and white icon a page tile gets while its page is showing. Scoped to that tile, so the
             blocker's own look is untouched. -->
        <Style Selector="ToggleButton.locationsTile:checked /template/ Border#BackgroundBorder">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.locationsTile:checked /template/ ContentPresenter#TileContent">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- The shield's colour is deliberately not styled here: SetAdBlockerState assigns the icon's Foreground
             directly, which is a local value, so a style setter would never be able to change it anyway. The
             tile's rounded hover fill above is the tile's only state feedback. -->

        <!-- ── The locations overlay's option cards ──
             The connect box's idiom: dark fill, 1px grey border, radius 8. A row is a real Button, so Fluent's
             Button theme paints its own hover and press fill and border onto the content presenter, which is what
             used to light the card up and swallow its border. Both levels therefore carry the same colours, so
             whichever of the two wins the result is identical:

                 rest              dark fill,     #2D3748 border,   dim label
                 hover (not chosen) / chosen       #99FFFFFF border, white label - hovering previews the chosen look
                 chosen + hover    brighter fill, #FFFFFF border,   white label
             The labels carry no colour of their own, so they follow the presenter's Foreground. The border, fill
             and label also fade the way the rest of the app's highlights do, rather than snapping, and the
             transitions are stated at both levels for the same reason the colours are: whichever one Fluent's
             states land on has to be the one that animates. -->
        <Style Selector="Button.locOption">
            <Setter Property="Background" Value="#CC141414"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.locOption /template/ ContentPresenter">
            <Setter Property="Background" Value="#CC141414"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.locOption:pointerover">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.locOption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#CC141414"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>
        <Style Selector="Button.locOption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#CC141414"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>

        <Style Selector="Button.locOption.selected">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.locOption.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>

        <!-- Hovering the chosen row is a step brighter than the chosen look itself. -->
        <Style Selector="Button.locOption.selected:pointerover">
            <Setter Property="Background" Value="#E6242424"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.locOption.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E6242424"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>

        <!-- ── The overlay's close button ──
             A bare glyph that lights up on hover. Its colour is styled rather than set inline, because a local
             value on the icon would win over the hover rule below. -->
        <Style Selector="Button.locClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.locClose /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.locClose PathIcon">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.locClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.locClose:pointerover PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.locClose:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>

        <!-- ── The rail ──
             A docked column, not a floating pill: it fills the shell from edge to edge and only carries a 1px
             divider on its right. Items are icon + 10px padding tiles (38 wide, 37 tall) with a 10px radius,
             which the 7px padding keeps clear of every edge of the panel; the names live in tooltips. -->
        <Style Selector="Border.sideRail">
            <Setter Property="Background" Value="#CC141414"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="8,0,0,8"/>
            <!-- Inset 1px from the shell so this background cannot cover the shell's own 1px outline. A Border
                 paints its background before anything else, and this one sits flush at x=0 with the same 8px
                 radius, so it used to paint exactly over that line - most visibly around the top left corner.
                 Clipped as well: the tiles are inset 7px, so their own fills stay inside the rail's corners. -->
            <Setter Property="Margin" Value="1"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Padding" Value="7,7,6,7"/>
            <Setter Property="Width" Value="52"/>
        </Style>

    </UserControl.Styles>

    <Panel>
        <Border x:Name="sideRail" Classes="sideRail" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- The app's own icon doubles as the About entry: clicking it opens the About tab -->
            <RadioButton x:Name="btnNavAbout" Grid.Row="0" Classes="navBtn" GroupName="NavGroup" Tag="About" IsCheckedChanged="NavButton_Checked"
                         Padding="10,6" ToolTip.Tip="CrimsonX">
                <Image Source="avares://CrimsonX/Assets/CrimsonX.ico" Width="25" Height="25" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </RadioButton>

            <!-- Home / Split Tunneling / Themes / Apps & Games sit in the middle of the rail -->
            <StackPanel x:Name="NavStack" Grid.Row="1" Orientation="Vertical" Spacing="6" VerticalAlignment="Center">
                <RadioButton x:Name="btnNavHome" Classes="navBtn" GroupName="NavGroup" IsChecked="True" Tag="Home" IsCheckedChanged="NavButton_Checked"
                             ToolTip.Tip="HOME">
                    <PathIcon Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Width="17" Height="17"/>
                </RadioButton>

                <!-- Locations filter: a toggle rather than a page - it opens the small overlay further down this
                     file. Placement is deliberate: directly under Home. It reuses the rail tile's style, and the
                     globe is the same glyph the app uses for this setting everywhere else. -->
                <ToggleButton x:Name="btnNavLocations" Classes="railTile locationsTile" IsCheckedChanged="NavLocations_Changed"
                              ToolTip.Tip="LOCATIONS">
                    <PathIcon x:Name="navLocationsIcon"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                              Width="17" Height="17"/>
                </ToggleButton>
                <RadioButton x:Name="btnNavSplit" Classes="navBtn" GroupName="NavGroup" Tag="SplitTunneling" IsCheckedChanged="NavButton_Checked"
                             ToolTip.Tip="SPLIT TUNNELING">
                    <PathIcon Data="M9,3L7.59,4.41L10.17,7H4V9H10.17L7.59,11.59L9,13L14,8L9,3M15,11L13.59,12.41L16.17,15H4V17H16.17L13.59,19.59L15,21L20,16L15,11Z" Width="17" Height="17"/>
                </RadioButton>
                <RadioButton x:Name="btnNavThemes" Classes="navBtn themeNavBtn" GroupName="NavGroup" Tag="Themes" IsCheckedChanged="NavButton_Checked"
                             ToolTip.Tip="THEMES">
                    <!-- Wears the same rest, hover and checked colours as every other rail icon while its tab is
                         closed; ShowThemeIcon turns it white while the Themes tab is open, because the tile
                         itself is then showing the theme gradient (ThemeCurrentBrush) as its highlight. -->
                    <PathIcon x:Name="themeNavIcon" Data="M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A9,9 0 0,0 21,12C21,10.62 19.88,9.5 18.5,9.5C17.79,9.5 17.15,9.79 16.69,10.26C16.5,10.45 16.27,10.57 16,10.57C15.45,10.57 15,10.12 15,9.57V8.5C15,5.46 13.66,3 12,3M6.5,10C5.67,10 5,9.33 5,8.5C5,7.67 5.67,7 6.5,7C7.33,7 8,7.67 8,8.5C8,9.33 7.33,10 6.5,10M9,6C8.17,6 7.5,5.33 7.5,4.5C7.5,3.67 8.17,3 9,3C9.83,3 10.5,3.67 10.5,4.5C10.5,5.33 9.83,6 9,6M15,6C14.17,6 13.5,5.33 13.5,4.5C13.5,3.67 14.17,3 15,3C15.83,3 16.5,3.67 16.5,4.5C16.5,5.33 15.83,6 15,6Z" Width="17" Height="17"/>
                </RadioButton>
                <!-- Opens the Settings host with the UDP scanner page selected; this tile is what stays
                     highlighted while that page is up, which is why the page no longer carries a back arrow. -->
                <RadioButton x:Name="btnNavUdp" Classes="navBtn" GroupName="NavGroup" Tag="UdpScanner" IsCheckedChanged="NavButton_Checked"
                             ToolTip.Tip="UDP SCANNER">
                    <PathIcon Data="M20.38 8.57l-1.23 1.85a8 8 0 0 1-.22 7.58H5.07A8 8 0 0 1 15.58 6.85l1.85-1.23A10 10 0 0 0 3.35 19a2 2 0 0 0 1.72 1h13.85a2 2 0 0 0 1.74-1 10 10 0 0 0-.27-10.44zm-9.79 6.84a2 2 0 0 0 2.83 0l5.66-8.49-8.49 5.66a2 2 0 0 0 0 2.83z" Width="17" Height="17"/>
                </RadioButton>

                <RadioButton x:Name="btnNavAppsGames" Classes="navBtn" GroupName="NavGroup" Tag="AppsGames" IsCheckedChanged="NavButton_Checked"
                             ToolTip.Tip="APPS &amp; GAMES">
                    <PathIcon Data="m21.58 16.09-1.09-7.66A3.996 3.996 0 0 0 16.53 5H7.47C5.48 5 3.79 6.46 3.51 8.43l-1.09 7.66a2.545 2.545 0 0 0 4.32 2.16L9 16h6l2.25 2.25c.48.48 1.13.75 1.8.75 1.56 0 2.75-1.37 2.53-2.91zM11 11H9v2H8v-2H6v-1h2V8h1v2h2v1zm4-1c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2 3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" Width="17" Height="17"/>
                </RadioButton>
            </StackPanel>

            <!-- The blocker sits directly above the gear: it is a toggle rather than a page, so it stays out of
                 NavGroup and cannot navigate. Its icon is a PathIcon like the nav items, and its Foreground is
                 assigned by SetAdBlockerState in the code-behind. -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="6">
                <ToggleButton x:Name="btnNavAdBlock" Classes="railTile" IsCheckedChanged="AdBlocker_Changed"
                              ToolTip.Tip="AD AND TRACKER BLOCKER">
                    <PathIcon x:Name="adBlockIcon"
                              Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                              Width="17" Height="17"/>
                </ToggleButton>

                <!-- Settings is pinned to the bottom of the rail -->
                <RadioButton x:Name="btnNavSettings" Classes="navBtn" GroupName="NavGroup" Tag="Settings" IsCheckedChanged="NavButton_Checked"
                             ToolTip.Tip="SETTINGS">
                    <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Width="17" Height="17"/>
                </RadioButton>
            </StackPanel>
        </Grid>
        </Border>

        <!-- The locations overlay. The top-right anchor with bottom-right gravity is what lines its top edge up
             with the top of the tile's highlight: plain Right placement centres the card on the tile instead.
             Light dismissing is off, matching the app's other popups - an outside click lands on the window's
             LightDismissOverlay and closes this one through ClosePopups, so that close animates too. -->
        <Popup x:Name="LocationsPopup" Placement="AnchorAndGravity" PlacementAnchor="TopRight"
               PlacementGravity="BottomRight" HorizontalOffset="-1" VerticalOffset="-12"
               IsLightDismissEnabled="False" Closed="LocationsPopup_Closed">
            <!-- Inset 12px on every side because a popup clips at its own bounds: the shadow needs that room to
                 render. The placement offsets above are pulled back by the same 12px, so the card still starts on
                 the top-right corner of the tile. -->
            <Border x:Name="LocationsCard" Classes="popupContent" Background="#F20E1014" BorderBrush="#2D3748"
                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="12"
                    BoxShadow="0 6 18 -2 #E6000000" Width="176">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="lblLocationsTitle" Grid.Column="0" Text="LOCATIONS" FontSize="10"
                                   FontWeight="Bold" Foreground="#A0AEC0" LetterSpacing="1" VerticalAlignment="Center"
                                   Margin="3,0,0,0"/>
                        <Button x:Name="btnLocationsClose" Grid.Column="1" Classes="locClose" Click="LocationsClose_Click"
                                HorizontalAlignment="Right">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41z" Width="9" Height="9"/>
                        </Button>
                    </Grid>
                    <ItemsControl x:Name="lstLocations">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:LocationOption">
                                <Grid>
                                    <Button Classes="locOption" IsVisible="{Binding IsNotSelected}" Click="LocationOption_Click">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Classes="locOption selected" IsVisible="{Binding IsSelected}" Click="LocationOption_Click">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Panel>
</UserControl>
