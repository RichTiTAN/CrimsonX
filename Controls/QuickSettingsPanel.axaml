<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:CrimsonX.Localization"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="200"
             x:Class="CrimsonX.Controls.QuickSettingsPanel">
    <UserControl.Styles>
        <Style Selector="ComboBox.customProxy">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ComboBox.customProxy /template/ TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.qsFieldLabel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1,1,0,1"/>
            <Setter Property="CornerRadius" Value="4,0,0,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Width" Value="48"/>
        </Style>
        <Style Selector="Border.qsFieldLabel TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style Selector="Button.plusBtn PathIcon">
            <Setter Property="Foreground" Value="#A0AEC0"/>
        </Style>
        <Style Selector="Button.plusBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Grid.cfgCells Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2AFFFFFF"/>
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.qsTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.qsTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
    </UserControl.Styles>
             
    <Panel>
        <Border Classes="hoverBox" Background="#CC0A0C0F" BorderThickness="1" CornerRadius="8" Padding="6">
            <StackPanel Spacing="6">
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="btnQSTabQuick" Classes="qsTab" Click="QSTab_Click">
                            <TextBlock x:Name="lblQuickSettings" Text="QUICK SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0" LetterSpacing="1" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnQSTabCustom" Classes="qsTab" Click="QSTab_Click">
                            <TextBlock x:Name="lblQSTabCustom" Text="CUSTOM CONFIGS" FontSize="10" FontWeight="Bold" Foreground="#718096" LetterSpacing="1" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Panel VerticalAlignment="Center">
                        <!-- Default mode button -->
                        <Button x:Name="btnCustomize" Click="btnCustomize_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Opacity="1" HorizontalAlignment="Right">
                            <Button.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Button.Transitions>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="8" Height="8" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblCustomize" Text="CUSTOMIZE" FontSize="8" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Edit mode buttons -->
                        <StackPanel x:Name="panEditButtons" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </StackPanel.Transitions>
                            
                            <Button x:Name="btnSave" Click="btnSave_Click" Background="#2034D399" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Width="60" HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#3034D399"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock x:Name="lblSave" Text="{x:Static loc:AppStrings.Save}" FontSize="10" FontWeight="Bold" Foreground="#34D399" LetterSpacing="1" VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="btnCancel" Click="btnCancel_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Width="60" HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock x:Name="lblCancel" Text="CANCEL" FontSize="10" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="panCustomActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </StackPanel.Transitions>


                            <Button x:Name="btnQSSubmit" Click="btnQSSubmit_Click" Background="#2034D399" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Width="60" HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#3034D399"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock x:Name="lblQSSubmit" Text="SUBMIT" FontSize="10" FontWeight="Bold" Foreground="#34D399" LetterSpacing="1" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        </Panel>
                        <Button x:Name="btnQSCustomMore" Classes="qsTab" IsVisible="False" VerticalAlignment="Stretch" Click="QSCustomMore_Click">
                            <TextBlock x:Name="lblQSCustomMore" Text="MORE SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Carousel x:Name="panQSCarousel" Focusable="False">
                    <Carousel.PageTransition>
                        <PageSlide Duration="0:0:0.25" Orientation="Horizontal"/>
                    </Carousel.PageTransition>

                        <!-- View 1: the quick settings slots -->
                        <Grid x:Name="panQSViewQuick" ColumnDefinitions="*, 6, *" Margin="0,0,0,0">
                    
                    <!-- Slot 1 -->
                    <Border Grid.Column="0" BorderBrush="#2D3748" BorderThickness="1" Background="Transparent" CornerRadius="8" Padding="12,5.5">
                        <Panel>
                            <Grid x:Name="panSlot1Content" ColumnDefinitions="*, Auto" MinHeight="20" Opacity="1">
                                <Grid.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Grid.Transitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Grid.Column="0">
                                    <PathIcon x:Name="icoSlot1" Width="12" Height="12" Foreground="#8B949E"/>
                                    <TextBlock x:Name="lblSlot1" Classes="settingTitle" Text="CUSTOM CONFIGS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Stretch="Uniform" Height="24" HorizontalAlignment="Right"><ToggleSwitch x:Name="togSlot1" OnContent="{x:Null}" OffContent="{x:Null}" IsCheckedChanged="TogSlot1_IsCheckedChanged"/></Viewbox>
                            </Grid>
                            <PathIcon x:Name="iconArrow1" Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#8B949E" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </PathIcon.Transitions>
                            </PathIcon>
                            <Button x:Name="btnSlot1" Opacity="0" IsHitTestVisible="False" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="btnSlot1_Click"/>
                        </Panel>
                    </Border>
                    
                    <!-- Slot 2 -->
                    <Border Grid.Column="2" BorderBrush="#2D3748" BorderThickness="1" Background="Transparent" CornerRadius="8" Padding="12,5.5">
                        <Panel>
                            <Grid x:Name="panSlot2Content" ColumnDefinitions="*, Auto" MinHeight="20" Opacity="1">
                                <Grid.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Grid.Transitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Grid.Column="0">
                                    <PathIcon x:Name="icoSlot2" Width="12" Height="12" Foreground="#8B949E"/>
                                    <TextBlock x:Name="lblSlot2" Classes="settingTitle" Text="AUTO-CONNECT" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Stretch="Uniform" Height="24" HorizontalAlignment="Right"><ToggleSwitch x:Name="togSlot2" OnContent="{x:Null}" OffContent="{x:Null}" IsCheckedChanged="TogSlot2_IsCheckedChanged"/></Viewbox>
                            </Grid>
                            <PathIcon x:Name="iconArrow2" Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#8B949E" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </PathIcon.Transitions>
                            </PathIcon>
                            <Button x:Name="btnSlot2" Opacity="0" IsHitTestVisible="False" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="btnSlot2_Click"/>
                        </Panel>
                    </Border>

                        </Grid>

                        <Grid x:Name="panQSViewCustom" Classes="cfgCells" Margin="0,5.5,0,5.5">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,10,*">
                                    <!-- Config 1 -->
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" MinHeight="26">
                                        <Border Grid.Column="0" Classes="qsFieldLabel">
                                            <ToggleSwitch x:Name="togQSCfg1" Tag="1" Theme="{StaticResource CompactSlotSwitch}" HorizontalAlignment="Center" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" Margin="0" IsCheckedChanged="TogQSCfg_IsCheckedChanged"/>
                                        </Border>
                                        <ComboBox x:Name="cbQSCustomConfig1" Grid.Column="1" Classes="customProxy" IsEditable="True" SelectedIndex="-1" MinHeight="26" Height="26" PlaceholderText="Config 1 — paste or + file" Background="Transparent" BorderBrush="#2D3748" BorderThickness="1" FontFamily="Consolas" FontSize="11" CornerRadius="0" Padding="8,5,4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0"/>
                                        <Border Grid.Column="2" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgImport1" Classes="plusBtn" Tag="1" Click="btnQSCfgImport_Click" ToolTip.Tip="{x:Static loc:AppStrings.ImportConfigTooltip}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                                            </Button>
                                        </Border>
                                        <Border Grid.Column="3" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgPing1" Classes="plusBtn" Tag="1" Click="btnQSCfgPing_Click" ToolTip.Tip="{x:Static loc:AppStrings.TtSavedConfigsPing}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                <PathIcon Data="M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.12,4.34 1,6.6L3.2,9.2C5.61,7.55 8.68,6.6 12,6.6C15.32,6.6 18.39,7.55 20.8,9.2L23,6.6C19.88,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.5C8.08,12.28 9.95,11.6 12,11.6C14.05,11.6 15.92,12.28 17.4,13.5L19.2,11.4C17.19,9.89 14.7,9 12,9Z" Width="12" Height="12"/>
                                            </Button>
                                        </Border>
                                        <Border Grid.Column="4" Background="Transparent" CornerRadius="0,4,4,0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgSave1" Classes="plusBtn" Tag="1" Click="btnQSCfgSave_Click" ToolTip.Tip="{x:Static loc:AppStrings.SaveToPoolTooltip}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0" Padding="0">
                                                <PathIcon Data="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M15,9H5V5H15V9Z" Width="12" Height="12"/>
                                            </Button>
                                        </Border>
                                    </Grid>
                                    <!-- Config 2 -->
                                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" MinHeight="26">
                                        <Border Grid.Column="0" Classes="qsFieldLabel">
                                            <ToggleSwitch x:Name="togQSCfg2" Tag="2" Theme="{StaticResource CompactSlotSwitch}" HorizontalAlignment="Center" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" Margin="0" IsCheckedChanged="TogQSCfg_IsCheckedChanged"/>
                                        </Border>
                                        <ComboBox x:Name="cbQSCustomConfig2" Grid.Column="1" Classes="customProxy" IsEditable="True" SelectedIndex="-1" MinHeight="26" Height="26" PlaceholderText="Config 2 — paste or + file" Background="Transparent" BorderBrush="#2D3748" BorderThickness="1" FontFamily="Consolas" FontSize="11" CornerRadius="0" Padding="8,5,4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0"/>
                                        <Border Grid.Column="2" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgImport2" Classes="plusBtn" Tag="2" Click="btnQSCfgImport_Click" ToolTip.Tip="{x:Static loc:AppStrings.ImportConfigTooltip}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                                            </Button>
                                        </Border>
                                        <Border Grid.Column="3" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgPing2" Classes="plusBtn" Tag="2" Click="btnQSCfgPing_Click" ToolTip.Tip="{x:Static loc:AppStrings.TtSavedConfigsPing}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                <PathIcon Data="M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.12,4.34 1,6.6L3.2,9.2C5.61,7.55 8.68,6.6 12,6.6C15.32,6.6 18.39,7.55 20.8,9.2L23,6.6C19.88,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.5C8.08,12.28 9.95,11.6 12,11.6C14.05,11.6 15.92,12.28 17.4,13.5L19.2,11.4C17.19,9.89 14.7,9 12,9Z" Width="12" Height="12"/>
                                            </Button>
                                        </Border>
                                        <Border Grid.Column="4" Background="Transparent" CornerRadius="0,4,4,0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgSave2" Classes="plusBtn" Tag="2" Click="btnQSCfgSave_Click" ToolTip.Tip="{x:Static loc:AppStrings.SaveToPoolTooltip}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0" Padding="0">
                                                <PathIcon Data="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M15,9H5V5H15V9Z" Width="12" Height="12"/>
                                            </Button>
                                        </Border>
                                    </Grid>

                                </Grid>
                            </StackPanel>
                        </Grid>
                </Carousel>
            </StackPanel>
        </Border>

        <!-- Popups -->
        <Popup x:Name="PopupSlot1" IsLightDismissEnabled="False"
               Placement="AnchorAndGravity" PlacementAnchor="None" PlacementGravity="Top">
            <Border Classes="popupContent" Background="#F2101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Width="195" Padding="2">
                <ScrollViewer MaxHeight="300">
                    <StackPanel x:Name="panPopupSlot1Items">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Popup x:Name="PopupSlot2" IsLightDismissEnabled="False"
               Placement="AnchorAndGravity" PlacementAnchor="None" PlacementGravity="Top">
            <Border Classes="popupContent" Background="#F2101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Width="195" Padding="2">
                <ScrollViewer MaxHeight="300">
                    <StackPanel x:Name="panPopupSlot2Items">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Panel>
</UserControl>
