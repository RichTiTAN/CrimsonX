<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:CrimsonX.Localization"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="200"
             x:Class="CrimsonX.Controls.QuickSettingsPanel">
    <UserControl.Styles>
        <Style Selector="ComboBox.customProxy">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ComboBox.customProxy /template/ TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.plusBtn PathIcon">
            <Setter Property="Foreground" Value="#A0AEC0"/>
        </Style>
        <Style Selector="Button.plusBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Grid.cfgCells Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2AFFFFFF"/>
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.qsTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.qsTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
    </UserControl.Styles>
             
    <Panel>
        <Border Classes="hoverBox" Background="#CC141414" BorderThickness="1" CornerRadius="8" Padding="6">
            <StackPanel Spacing="6">
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="btnQSTabQuick" Classes="qsTab" Click="QSTab_Click">
                            <TextBlock x:Name="lblQuickSettings" Text="QUICK SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0" LetterSpacing="1" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnQSTabCustom" Classes="qsTab" Click="QSTab_Click">
                            <TextBlock x:Name="lblQSTabCustom" Text="CUSTOM CONFIGS" FontSize="10" FontWeight="Bold" Foreground="#718096" LetterSpacing="1" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    
                    <Panel Grid.Column="1" HorizontalAlignment="Right">
                        <!-- Default mode button -->
                        <Button x:Name="btnCustomize" Click="btnCustomize_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Opacity="1" HorizontalAlignment="Right">
                            <Button.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Button.Transitions>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="8" Height="8" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblCustomize" Text="CUSTOMIZE" FontSize="8" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Edit mode buttons -->
                        <StackPanel x:Name="panEditButtons" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </StackPanel.Transitions>
                            
                            <Button x:Name="btnSave" Click="btnSave_Click" Background="#2034D399" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Width="60" HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#3034D399"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock x:Name="lblSave" Text="{x:Static loc:AppStrings.Save}" FontSize="10" FontWeight="Bold" Foreground="#34D399" LetterSpacing="1" VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="btnCancel" Click="btnCancel_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Width="60" HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock x:Name="lblCancel" Text="CANCEL" FontSize="10" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="panCustomActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </StackPanel.Transitions>

                            <Button x:Name="btnQSAllowSingle" Classes="pillBtn" Click="btnQSAllowSingle_Click">
                                <TextBlock x:Name="lblQSAllowSingle" Text="ALLOW SINGLE CONFIG" FontSize="9" FontWeight="Bold" LetterSpacing="0.5" VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="btnQSSubmit" Click="btnQSSubmit_Click" Background="#2034D399" BorderThickness="0" Cursor="Hand" Padding="8,4" CornerRadius="4" Width="60" HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#3034D399"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock x:Name="lblQSSubmit" Text="SUBMIT" FontSize="10" FontWeight="Bold" Foreground="#34D399" LetterSpacing="1" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Panel>
                </Grid>

                <Carousel x:Name="panQSCarousel" Focusable="False">
                    <Carousel.PageTransition>
                        <PageSlide Duration="0:0:0.25" Orientation="Horizontal"/>
                    </Carousel.PageTransition>

                        <!-- View 1: the quick settings slots -->
                        <Grid x:Name="panQSViewQuick" ColumnDefinitions="*, 6, *" Margin="0,0,0,0">
                    
                    <!-- Slot 1 -->
                    <Border Grid.Column="0" BorderBrush="#2D3748" BorderThickness="1" Background="Transparent" CornerRadius="8" Padding="12,5.5">
                        <Panel>
                            <Grid x:Name="panSlot1Content" ColumnDefinitions="*, Auto" MinHeight="20" Opacity="1">
                                <Grid.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Grid.Transitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Grid.Column="0">
                                    <PathIcon x:Name="icoSlot1" Width="12" Height="12" Foreground="#8B949E"/>
                                    <TextBlock x:Name="lblSlot1" Classes="settingTitle" ToolTip.Tip="Placeholder" Text="CUSTOM CONFIGS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Stretch="Uniform" Height="24" HorizontalAlignment="Right"><ToggleSwitch x:Name="togSlot1" OnContent="{x:Null}" OffContent="{x:Null}" IsCheckedChanged="TogSlot1_IsCheckedChanged"/></Viewbox>
                            </Grid>
                            <PathIcon x:Name="iconArrow1" Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#8B949E" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </PathIcon.Transitions>
                            </PathIcon>
                            <Button x:Name="btnSlot1" Opacity="0" IsHitTestVisible="False" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="btnSlot1_Click"/>
                        </Panel>
                    </Border>
                    
                    <!-- Slot 2 -->
                    <Border Grid.Column="2" BorderBrush="#2D3748" BorderThickness="1" Background="Transparent" CornerRadius="8" Padding="12,5.5">
                        <Panel>
                            <Grid x:Name="panSlot2Content" ColumnDefinitions="*, Auto" MinHeight="20" Opacity="1">
                                <Grid.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Grid.Transitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Grid.Column="0">
                                    <PathIcon x:Name="icoSlot2" Width="12" Height="12" Foreground="#8B949E"/>
                                    <TextBlock x:Name="lblSlot2" Classes="settingTitle" ToolTip.Tip="Placeholder" Text="AUTO-CONNECT" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Stretch="Uniform" Height="24" HorizontalAlignment="Right"><ToggleSwitch x:Name="togSlot2" OnContent="{x:Null}" OffContent="{x:Null}" IsCheckedChanged="TogSlot2_IsCheckedChanged"/></Viewbox>
                            </Grid>
                            <PathIcon x:Name="iconArrow2" Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#8B949E" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </PathIcon.Transitions>
                            </PathIcon>
                            <Button x:Name="btnSlot2" Opacity="0" IsHitTestVisible="False" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="btnSlot2_Click"/>
                        </Panel>
                    </Border>

                        </Grid>

                        <Grid x:Name="panQSViewCustom" Classes="cfgCells" Margin="0,5.5,0,5.5">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,10,*">
                                    <!-- Config 1 -->
                                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto,Auto" MinHeight="26">
                                        <ComboBox x:Name="cbQSCustomConfig1" Grid.Column="0" Classes="customProxy" IsEditable="True" SelectedIndex="-1" MinHeight="26" Height="26" PlaceholderText="Config 1 — paste or + file" Background="Transparent" BorderBrush="#2D3748" BorderThickness="1" FontFamily="Consolas" FontSize="11" CornerRadius="4,0,0,4" Padding="8,5,4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0"/>
                                        <Border Grid.Column="1" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgImport1" Classes="plusBtn" Tag="1" Click="btnQSCfgImport_Click" ToolTip.Tip="{x:Static loc:AppStrings.ImportConfigTooltip}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="9" Height="9"/>
                                            </Button>
                                        </Border>
                                        <Border Grid.Column="2" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="46" MinHeight="26">
                                            <Button x:Name="btnQSCfgPing1" Tag="1" Click="btnQSCfgPing_Click" Content="{x:Static loc:AppStrings.PingBtn}" ToolTip.Tip="{x:Static loc:AppStrings.TtSavedConfigsPing}" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0"/>
                                        </Border>
                                        <Border Grid.Column="3" Background="Transparent" CornerRadius="0,4,4,0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="46" MinHeight="26">
                                            <Button x:Name="btnQSCfgSave1" Tag="1" Click="btnQSCfgSave_Click" Content="{x:Static loc:AppStrings.Save}" ToolTip.Tip="{x:Static loc:AppStrings.SaveToPoolTooltip}" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0" Padding="0"/>
                                        </Border>
                                    </Grid>
                                    <!-- Config 2 -->
                                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto,Auto" MinHeight="26">
                                        <ComboBox x:Name="cbQSCustomConfig2" Grid.Column="0" Classes="customProxy" IsEditable="True" SelectedIndex="-1" MinHeight="26" Height="26" PlaceholderText="Config 2 — paste or + file" Background="Transparent" BorderBrush="#2D3748" BorderThickness="1" FontFamily="Consolas" FontSize="11" CornerRadius="4,0,0,4" Padding="8,5,4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0"/>
                                        <Border Grid.Column="1" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="26" MinHeight="26">
                                            <Button x:Name="btnQSCfgImport2" Classes="plusBtn" Tag="2" Click="btnQSCfgImport_Click" ToolTip.Tip="{x:Static loc:AppStrings.ImportConfigTooltip}" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="9" Height="9"/>
                                            </Button>
                                        </Border>
                                        <Border Grid.Column="2" Background="Transparent" CornerRadius="0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="46" MinHeight="26">
                                            <Button x:Name="btnQSCfgPing2" Tag="2" Click="btnQSCfgPing_Click" Content="{x:Static loc:AppStrings.PingBtn}" ToolTip.Tip="{x:Static loc:AppStrings.TtSavedConfigsPing}" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0"/>
                                        </Border>
                                        <Border Grid.Column="3" Background="Transparent" CornerRadius="0,4,4,0" BorderBrush="#2D3748" BorderThickness="0,1,1,1" Width="46" MinHeight="26">
                                            <Button x:Name="btnQSCfgSave2" Tag="2" Click="btnQSCfgSave_Click" Content="{x:Static loc:AppStrings.Save}" ToolTip.Tip="{x:Static loc:AppStrings.SaveToPoolTooltip}" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0" Padding="0"/>
                                        </Border>
                                    </Grid>

                                </Grid>
                            </StackPanel>
                        </Grid>
                </Carousel>
            </StackPanel>
        </Border>

        <!-- Popups -->
        <Popup x:Name="PopupSlot1" IsLightDismissEnabled="False"
               Placement="AnchorAndGravity" PlacementAnchor="None" PlacementGravity="Top">
            <Border Classes="popupContent" Background="#E6101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Width="195" Padding="2">
                <ScrollViewer MaxHeight="300">
                    <StackPanel x:Name="panPopupSlot1Items">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Popup x:Name="PopupSlot2" IsLightDismissEnabled="False"
               Placement="AnchorAndGravity" PlacementAnchor="None" PlacementGravity="Top">
            <Border Classes="popupContent" Background="#E6101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Width="195" Padding="2">
                <ScrollViewer MaxHeight="300">
                    <StackPanel x:Name="panPopupSlot2Items">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Panel>
</UserControl>
