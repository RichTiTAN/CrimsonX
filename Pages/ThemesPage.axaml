<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CrimsonX.Pages.ThemesPage">
    
    <Grid>
        <Border Background="Transparent" BorderThickness="0" Padding="6" Margin="0,50,20,20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel Margin="0" Spacing="6">
                
                <Border Classes="hoverBox" Background="#CC141414" BorderThickness="1" CornerRadius="8" Padding="15,10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,15,0">
                            <!-- Palette Icon -->
                            <PathIcon Data="M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A9,9 0 0,0 21,12C21,10.62 19.88,9.5 18.5,9.5C17.79,9.5 17.15,9.79 16.69,10.26C16.5,10.45 16.27,10.57 16,10.57C15.45,10.57 15,10.12 15,9.57V8.5C15,5.46 13.66,3 12,3M6.5,10C5.67,10 5,9.33 5,8.5C5,7.67 5.67,7 6.5,7C7.33,7 8,7.67 8,8.5C8,9.33 7.33,10 6.5,10M9,6C8.17,6 7.5,5.33 7.5,4.5C7.5,3.67 8.17,3 9,3C9.83,3 10.5,3.67 10.5,4.5C10.5,5.33 9.83,6 9,6M15,6C14.17,6 13.5,5.33 13.5,4.5C13.5,3.67 14.17,3 15,3C15.83,3 16.5,3.67 16.5,4.5C16.5,5.33 15.83,6 15,6Z" Width="14" Height="14" Foreground="#8B949E"/>
                            <TextBlock x:Name="lblChooseAColour" Text="CHOOSE A COLOUR" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Grid Grid.Column="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Crimson -->
                            <Button Classes="ThemeColorButton" Grid.Row="0" Grid.Column="0" Cursor="Hand" Click="ThemeSelect_Click" CommandParameter="Crimson" Margin="0,0,6,6" Background="Transparent" Padding="0" BorderThickness="0" Width="80">
                                <Border Height="30" HorizontalAlignment="Stretch" CornerRadius="4" ClipToBounds="True">
                                    <Panel Classes="animatedGradient" Background="Transparent">
                                        <Rectangle Fill="{DynamicResource ThemeCrimsonBrush}" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Classes="rectGradient" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeCrimsonBrush}">
                                            <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock x:Name="lblColorCrimson" Text="CRIMSON" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1C1C1C" FontWeight="Bold" FontSize="10" LetterSpacing="1"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <!-- Blue -->
                            <Button Classes="ThemeColorButton" Grid.Row="0" Grid.Column="1" Cursor="Hand" Click="ThemeSelect_Click" CommandParameter="Blue" Margin="0,0,6,6" Background="Transparent" Padding="0" BorderThickness="0" Width="80">
                                <Border Height="30" HorizontalAlignment="Stretch" CornerRadius="4" ClipToBounds="True">
                                    <Panel Classes="animatedGradient" Background="Transparent">
                                        <Rectangle Fill="{DynamicResource ThemeBlueBrush}" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Classes="rectGradient" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeBlueBrush}">
                                            <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock x:Name="lblColorBlue" Text="BLUE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1C1C1C" FontWeight="Bold" FontSize="10" LetterSpacing="1"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <!-- Purple -->
                            <Button Classes="ThemeColorButton" Grid.Row="0" Grid.Column="2" Cursor="Hand" Click="ThemeSelect_Click" CommandParameter="Purple" Margin="0,0,0,6" Background="Transparent" Padding="0" BorderThickness="0" Width="80">
                                <Border Height="30" HorizontalAlignment="Stretch" CornerRadius="4" ClipToBounds="True">
                                    <Panel Classes="animatedGradient" Background="Transparent">
                                        <Rectangle Fill="{DynamicResource ThemePurpleBrush}" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Classes="rectGradient" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemePurpleBrush}">
                                            <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock x:Name="lblColorPurple" Text="PURPLE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1C1C1C" FontWeight="Bold" FontSize="10" LetterSpacing="1"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <!-- Green -->
                            <Button Classes="ThemeColorButton" Grid.Row="1" Grid.Column="0" Cursor="Hand" Click="ThemeSelect_Click" CommandParameter="Green" Margin="0,0,6,0" Background="Transparent" Padding="0" BorderThickness="0" Width="80">
                                <Border Height="30" HorizontalAlignment="Stretch" CornerRadius="4" ClipToBounds="True">
                                    <Panel Classes="animatedGradient" Background="Transparent">
                                        <Rectangle Fill="{DynamicResource ThemeGreenBrush}" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Classes="rectGradient" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeGreenBrush}">
                                            <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock x:Name="lblColorGreen" Text="GREEN" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1C1C1C" FontWeight="Bold" FontSize="10" LetterSpacing="1"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <!-- Pink -->
                            <Button Classes="ThemeColorButton" Grid.Row="1" Grid.Column="1" Cursor="Hand" Click="ThemeSelect_Click" CommandParameter="Pink" Margin="0,0,6,0" Background="Transparent" Padding="0" BorderThickness="0" Width="80">
                                <Border Height="30" HorizontalAlignment="Stretch" CornerRadius="4" ClipToBounds="True">
                                    <Panel Classes="animatedGradient" Background="Transparent">
                                        <Rectangle Fill="{DynamicResource ThemePinkBrush}" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Classes="rectGradient" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemePinkBrush}">
                                            <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock x:Name="lblColorPink" Text="PINK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1C1C1C" FontWeight="Bold" FontSize="10" LetterSpacing="1"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <!-- Yellow -->
                            <Button Classes="ThemeColorButton" Grid.Row="1" Grid.Column="2" Cursor="Hand" Click="ThemeSelect_Click" CommandParameter="Yellow" Margin="0,0,0,0" Background="Transparent" Padding="0" BorderThickness="0" Width="80">
                                <Border Height="30" HorizontalAlignment="Stretch" CornerRadius="4" ClipToBounds="True">
                                    <Panel Classes="animatedGradient" Background="Transparent">
                                        <Rectangle Fill="{DynamicResource ThemeYellowBrush}" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Classes="rectGradient" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeYellowBrush}">
                                            <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                        </Rectangle>
                                        <TextBlock x:Name="lblColorYellow" Text="YELLOW" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1C1C1C" FontWeight="Bold" FontSize="10" LetterSpacing="1"/>
                                    </Panel>
                                </Border>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            
                    <Border Classes="hoverBox" Background="#CC141414" BorderThickness="1" CornerRadius="8" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Sparkle Icon -->
                            <PathIcon Data="M19,3H18V2H17V3H16V4H17V5H18V4H19V3M14,1H12V3H10V5H12V7H14V5H16V3H14V1M22,9H20V7H18V9H16V11H18V13H20V11H22V9M12.5,9.5L10,4L7.5,9.5L2,12L7.5,14.5L10,20L12.5,14.5L18,12L12.5,9.5Z" Width="14" Height="14" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <TextBlock x:Name="lblManageGlow" Text="MANAGE GLOW" Grid.Column="1" Foreground="#8B949E" FontSize="11" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button x:Name="btnPauseGlows" Classes="modeBtn" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="14,8" Cursor="Hand" Click="btnPauseGlows_Click">
                                    <TextBlock x:Name="lblPauseGlows" Classes="modeText" Text="PAUSE" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                                
                                <Button x:Name="btnDisableGlows" Classes="modeBtn" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="14,8" Cursor="Hand" Click="btnDisableGlows_Click">
                                    <TextBlock x:Name="lblDisableGlows" Classes="modeText" Text="DISABLE" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
</StackPanel>
        </Border>
    </Grid>
</UserControl>
