<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CrimsonX.Pages"
             xmlns:controls="clr-namespace:CrimsonX.Controls"
             x:Class="CrimsonX.Pages.AppsGamesOverlay">

    <UserControl.Styles>
        <Style Selector="RadioButton">
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="RadioButton /template/ Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
        <Style Selector="ComboBox /template/ Popup">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox.customProxy /template/ TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
            <Style Selector="RadioButton.pill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="4"
                            Padding="6,6"
                            HorizontalAlignment="Stretch">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.pill:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style Selector="RadioButton.pill:checked">
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="ScrollViewer#Scroller /template/ ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="0,45,0,0"/>
        </Style>
        <Style Selector="ScrollViewer#Scroller /template/ ScrollBar /template/ Thumb">
            <Setter Property="MinWidth" Value="3"/>
            <Setter Property="Background" Value="#66A0AEC0"/>
        </Style>
        <Style Selector="ScrollViewer#Scroller /template/ ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ScrollViewer#Scroller /template/ ScrollBar /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Border.floatBox">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BoxShadow" Value="0 0 26 6 #E6000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.floatBox:pointerover">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>

        <Style Selector="Border.connectBox">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 0 26 6 #E6000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.connectBox:pointerover">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
        </Style>
        <Style Selector="Border.connectBox.connected">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccessBrush}"/>
        </Style>
        <Style Selector="Border.connectBox.connected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccessPointerOverBrush}"/>
        </Style>

        <Style Selector="Border.shadowCarrier">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 0 26 6 #E6000000"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseInOut"/>
        </Transitions>
    </UserControl.Transitions>

    
        <Grid RowDefinitions="*" Margin="0,50,20,20" HorizontalAlignment="Center" MaxWidth="580" Width="580">
                <!-- Rules Box -->
                <Panel>
                <Border x:Name="panRulesBox" Background="#99141414" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="6,6,2,6">
                    <ScrollViewer x:Name="Scroller" BringIntoViewOnFocusChange="False">
                        <StackPanel Spacing="4" Margin="0,0,4,0">

                            <Border Height="45"/>

                            <!-- Rule List -->
                            <ItemsControl x:Name="lstRules">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AppRuleViewModel">
                                    <StackPanel>
                                        <Border x:Name="panRuleWrapper" MaxHeight="800" Opacity="1" ClipToBounds="True">
<Border.Transitions>
<Transitions>
<DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
<DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
</Transitions>
</Border.Transitions>
<Border Classes="hoverBox" Background="Transparent"
BorderThickness="1" CornerRadius="6" Padding="15,9.5" Height="45" Margin="0,0,0,0" IsVisible="{Binding !IsDefault}">
                                            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto">
                                                <Panel x:Name="DragHandle" Grid.Column="0" Tag="{Binding RuleId}" Width="16" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" Background="Transparent" Cursor="SizeAll">
                                                    <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Width="14" Height="14" Foreground="#4A5568" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Panel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                          Margin="0,0,10,0" VerticalAlignment="Center"
                                                          IsCheckedChanged="RuleEnabled_Changed"/>
                                                <Panel Grid.Column="2" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Image Source="{Binding IconBitmap}" Width="24" Height="24" Stretch="Uniform"
                                                           IsVisible="{Binding HasIcon}"/>
                                                    <Border Background="#2D3748" CornerRadius="6" Width="24" Height="24"
                                                            IsVisible="{Binding !HasIcon}">
                                                        <PathIcon Data="M20,4H4C2.89,4 2,4.89 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.89 21.1,4 20,4M20,18H4V6H20V18M8.5,15H11L12.5,11.5L14,15H16.5L13.5,10L16.5,5H14L12.5,8.5L11,5H8.5L11.5,10L8.5,15Z"
                                                                  Width="12" Height="12" Foreground="#8B949E"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Panel>
                                                <TextBlock Grid.Column="3" Text="{Binding ExeName}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="4" Tag="{Binding RuleId}"
                                                        Click="EditRule_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="6,4" Cursor="Hand" ToolTip.Tip="{Binding EditTooltip}">
                                                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                              Width="12" Height="12" Foreground="#606060"/>
                                                </Button>
                                                <Button Grid.Column="5" Tag="{Binding RuleId}"
                                                        Click="DeleteRule_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="6,4" Cursor="Hand" ToolTip.Tip="{Binding DeleteTooltip}">
                                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                              Width="12" Height="12" Foreground="#E53E3E"/>
                                                </Button>
                                                <Button Grid.Column="6" Tag="{Binding RuleId}"
                                                        Click="PinRule_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="6,4" Cursor="Hand" ToolTip.Tip="{Binding PinTooltip}">
                                                    <Panel Width="12" Height="12">
                                                        <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                                                                  Width="12" Height="12" Foreground="#E2E8F0" IsVisible="{Binding IsPinned}"/>
                                                        <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.2,14L10,12.2V4H14V12.2L15.8,14H8.2Z"
                                                                  Width="12" Height="12" Foreground="#606870" IsVisible="{Binding !IsPinned}"/>
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        </Border>
                                            <Border x:Name="panDefaultRuleWrapper" MaxHeight="800" Opacity="1" ClipToBounds="True">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                    </Transitions>
                                                </Border.Transitions>
                                                <Border Classes="hoverBox" Background="Transparent"
                                                        BorderThickness="1" CornerRadius="6" Padding="15,9.5" Height="45" Margin="0,0,0,0"
                                                        IsVisible="{Binding IsDefault}">
                                                    <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto, Auto, Auto, Auto">
                                                        <Panel x:Name="DragHandleDefault" Grid.Column="0" Tag="{Binding RuleId}" Width="16" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" Background="Transparent" Cursor="SizeAll">
                                                            <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Width="14" Height="14" Foreground="#4A5568" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Panel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                                  Margin="0,0,10,0" VerticalAlignment="Center"
                                                                  IsCheckedChanged="RuleEnabled_Changed"/>
                                                        <Panel Grid.Column="2" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Image Source="{Binding IconBitmap}" Width="24" Height="24" Stretch="Uniform"
                                                                   IsVisible="{Binding HasIcon}"/>
                                                            <Border Background="#2D3748" CornerRadius="6" Width="24" Height="24"
                                                                    IsVisible="{Binding !HasIcon}">
                                                                <PathIcon Data="M20,4H4C2.89,4 2,4.89 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.89 21.1,4 20,4M20,18H4V6H20V18M8.5,15H11L12.5,11.5L14,15H16.5L13.5,10L16.5,5H14L12.5,8.5L11,5H8.5L11.5,10L8.5,15Z"
                                                                      Width="12" Height="12" Foreground="#8B949E"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Panel>
                                                        <TextBlock Grid.Column="3" Text="{Binding ExeName}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ConfigLabel}" FontSize="8" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding HasCountry}"/>
                                                        <ComboBox x:Name="cbDefaultCountry" ItemsSource="{Binding CountryItems}" Grid.Column="5" Tag="{Binding RuleId}" IsVisible="{Binding HasCountry}"
                                                                  SelectedIndex="{Binding CountryIndex, Mode=OneWay}"
                                                                  SelectionChanged="DefaultCountry_SelectionChanged"
                                                                  Width="90" MinHeight="22" Height="22"
                                                                  Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                  FontSize="9" Padding="6,0" VerticalContentAlignment="Center" CornerRadius="4"></ComboBox>
                                                        <TextBlock Grid.Column="6" Text="{Binding RegionLabel}" FontSize="8" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="8,0,4,0" IsVisible="{Binding HasRegion}" ToolTip.Tip="{Binding RegionTooltip}"/>
                                                        <ComboBox x:Name="cbDefaultRegion" ItemsSource="{Binding RegionItems}" Grid.Column="7" Tag="{Binding RuleId}" IsVisible="{Binding HasRegion}"
                                                                  SelectedIndex="{Binding RegionIndex, Mode=OneWay}"
                                                                  SelectionChanged="DefaultRegion_SelectionChanged"
                                                                  Width="90" MinHeight="22" Height="22"
                                                                  Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                  FontSize="9" Padding="6,0" VerticalContentAlignment="Center" CornerRadius="4"></ComboBox>
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" IsVisible="{Binding ShowsRoutingPill}" Margin="0,0,2,0">
                                                            <Button Classes="optBtn" Classes.activeOpt="{Binding IsDirect}" Tag="{Binding RuleId}" Click="LauncherDirect_Click" Padding="9,3" CornerRadius="4,0,0,4">
                                                                <TextBlock Text="{Binding DirectLabel}" FontSize="8" FontWeight="Bold" LetterSpacing="0.5"/>
                                                            </Button>
                                                            <Button Classes="optBtn" Classes.activeOpt="{Binding !IsDirect}" Tag="{Binding RuleId}" Click="LauncherProxy_Click" Padding="9,3" CornerRadius="0,4,4,0">
                                                                <TextBlock Text="{Binding ProxyLabel}" FontSize="8" FontWeight="Bold" LetterSpacing="0.5"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <Button Grid.Column="8" Tag="{Binding RuleId}" IsVisible="{Binding ShowAdapterEditor}"
                                                                Click="EditDefaultRule_Click"
                                                                Background="Transparent" BorderThickness="0"
                                                                Margin="10,0,0,0"
                                                                Padding="6,4" Cursor="Hand" ToolTip.Tip="{Binding EditorTooltip}">
                                                            <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                                      Width="12" Height="12" Foreground="#606060"/>
                                                        </Button>
                                                        <Button Grid.Column="9" Tag="{Binding RuleId}"
                                                                Click="PinRule_Click"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="6,4" Cursor="Hand" ToolTip.Tip="{Binding PinTooltip}">
                                                            <Panel Width="12" Height="12">
                                                                <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                                                                          Width="12" Height="12" Foreground="#E2E8F0" IsVisible="{Binding IsPinned}"/>
                                                                <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.2,14L10,12.2V4H14V12.2L15.8,14H8.2Z"
                                                                          Width="12" Height="12" Foreground="#606870" IsVisible="{Binding !IsPinned}"/>
                                                            </Panel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Border>

                                        <ContentControl x:Name="EditContainer" Margin="0" IsVisible="False"/>
                                    </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- INLINE EDITOR -->
                            <Border x:Name="panOuterAdd" Background="Transparent" BorderThickness="0" ClipToBounds="True">
                            <StackPanel>
                                <Border x:Name="panAddToggleWrapper" MaxHeight="800" Opacity="1" ClipToBounds="True">
<Border.Transitions>
<Transitions>
<DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
<DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
</Transitions>
</Border.Transitions>
<Border x:Name="panAddToggle" Classes="hoverBox" Background="Transparent"  BorderThickness="1" CornerRadius="6" Padding="15,10" Height="45" Cursor="Hand" PointerPressed="AddToggle_Click">
                                    <TextBlock x:Name="lblAddToggle" Text="ADD +" FontSize="11" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center" LetterSpacing="1"/>
                                </Border>
                                </Border>

                                <!-- The Expanded Editor -->
                                <Border x:Name="panEditor" MaxHeight="0" Opacity="0" ClipToBounds="True">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                        </Transitions>
                                    </Border.Transitions>

                                    <Border Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8">
                                      <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" Margin="0,8,0,0">
                                        <!-- Header -->
                                        <Grid Grid.Row="0" Margin="12,0,12,10" ColumnDefinitions="*, Auto">
                                            <TextBlock x:Name="lblEditorHeader" Grid.Column="0" Text="ADD PROGRAM" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" LetterSpacing="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <Grid Grid.Column="1">
                                                <!-- Buttons -->
                                        
                                            <Border Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                    CornerRadius="4" Height="26">
                                                <Grid ColumnDefinitions="Auto, 1, *, 1, 80">
<Button x:Name="btnScanAdapters" Grid.Column="0"
Content="SCAN ADAPTERS" Click="BtnScanAdapters_Click"
FontSize="10" FontWeight="Bold" Foreground="#A0AEC0"
Background="Transparent" HorizontalAlignment="Stretch"
HorizontalContentAlignment="Center" VerticalAlignment="Stretch"
VerticalContentAlignment="Center" Padding="15,0"
Cursor="Hand" BorderThickness="0" CornerRadius="4,0,0,4">
<Button.Styles>
<Style Selector="Button:pointerover /template/ ContentPresenter">
<Setter Property="Background" Value="#2AFFFFFF"/>
<Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
</Style>
</Button.Styles>
</Button>
<Border Grid.Column="1" Background="#2D3748"/>
<Button x:Name="btnSubmit" Grid.Column="2"
Content="SUBMIT" Click="BtnSubmit_Click"
FontSize="10" FontWeight="Bold" Foreground="#E2E8F0"
Background="Transparent" HorizontalAlignment="Stretch"
HorizontalContentAlignment="Center" VerticalAlignment="Stretch"
VerticalContentAlignment="Center" Padding="20,0"
Cursor="Hand" BorderThickness="0" CornerRadius="0">
<Button.Styles>
<Style Selector="Button:pointerover /template/ ContentPresenter">
<Setter Property="Background" Value="#2AFFFFFF"/>
<Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
</Style>
</Button.Styles>
</Button>
<Border Grid.Column="3" Background="#2D3748"/>
<Button x:Name="btnCancel" Grid.Column="4"
Content="CANCEL" Click="BtnCancel_Click"
FontSize="10" FontWeight="Bold" Foreground="#A0AEC0"
Background="Transparent" HorizontalAlignment="Stretch"
HorizontalContentAlignment="Center" VerticalAlignment="Stretch"
VerticalContentAlignment="Center"
Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0">
<Button.Styles>
<Style Selector="Button:pointerover /template/ ContentPresenter">
<Setter Property="Background" Value="#2AFFFFFF"/>
<Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
</Style>
</Button.Styles>
</Button>
</Grid>
                                            </Border>
                                            </Grid>
                                        </Grid>

                                        <!-- Horizontal Separator -->
                                        <Border Grid.Row="1" Height="1" Background="#2D3748" HorizontalAlignment="Stretch"/>

                                        <!-- Main Content: 3 columns -->
                                        <Grid Grid.Row="2" ColumnDefinitions="0.85*, Auto, 1.15*, Auto, Auto">

                                            <!-- TYPE box -->
                                            <Border Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Margin="12,10,0,10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock x:Name="lblType" Text="TYPE" FontSize="10" FontWeight="Bold" Foreground="#8B949E"
                                                               LetterSpacing="1" Margin="0,0,0,4"/>
                                                    <RadioButton x:Name="rbGame" Classes="pill" GroupName="AppType" Content="GAME" IsChecked="True"/>
                                                    <RadioButton x:Name="rbLaunch" Classes="pill" GroupName="AppType" Content="LAUNCHER"/>
                                                    <RadioButton x:Name="rbOther" Classes="pill" GroupName="AppType" Content="OTHER"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Separator -->
                                            <Border Grid.Column="1" Width="1" Background="#2D3748" Margin="12,0,12,0"/>

                                            <!-- APP box -->
                                            <Border Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,10">
                                                <Grid RowDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Row="0" x:Name="lblApp" Text="APP" FontSize="10" FontWeight="Bold"
                                                               Foreground="#8B949E" LetterSpacing="1" Margin="0,0,0,4"/>
                                                    
                                                    <!-- Icon / placeholder -->
                                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <Panel Width="32" Height="32">
                                                            <Image x:Name="imgAppIcon" Width="32" Height="32" Stretch="Uniform"
                                                                   HorizontalAlignment="Center" IsVisible="False"/>
                                                            <Border x:Name="iconPlaceholder" Width="32" Height="32"
                                                                    Background="Transparent" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock x:Name="lblExeName" Text="" FontSize="9" Foreground="#606060"
                                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="76"/>
                                                    </StackPanel>

                                                    <!-- Browse button -->
                                                    <Border Grid.Row="2" VerticalAlignment="Bottom" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                            CornerRadius="4" Height="26" HorizontalAlignment="Stretch" Margin="0">
                                                        <Button x:Name="btnBrowse" Content="BROWSE" FontSize="9" FontWeight="Bold"
                                                                Foreground="#A0AEC0" Background="Transparent"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                                Padding="0" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                                                                Click="BtnBrowse_Click">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Separator -->
                                            <Border Grid.Column="3" Width="1" Background="#2D3748" Margin="12,0,12,0"/>

                                            <!-- ROUTING + ADAPTER box -->
                                            <Border Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,0">
                                                <Grid ColumnDefinitions="Auto, Auto, Auto">

                                                    <!-- ROUTING -->
                                                    <StackPanel Grid.Column="0" Spacing="8" Margin="0,10,0,10">
                                                          <TextBlock x:Name="lblRouting" Text="ROUTING" FontSize="10" FontWeight="Bold"
                                                                   Foreground="#8B949E" LetterSpacing="1" Margin="0,0,0,4"/>
                                                        <!-- TCP -->
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="TCP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbTcpRouting" SelectedIndex="0" Width="150" MinHeight="26"
                                                                      SelectionChanged="Routing_SelectionChanged"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Height="26" Padding="8,0"
                                                                      VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"></ComboBox>
                                                        </StackPanel>
                                                        <!-- UDP -->
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="UDP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbUdpRouting" SelectedIndex="1" Width="150" MinHeight="26"
                                                                      SelectionChanged="Routing_SelectionChanged"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Height="26" Padding="8,0"
                                                                      VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"></ComboBox>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Separator -->
                                                    <Border Grid.Column="1" Width="1" Background="#2D3748" Margin="12,0,12,0"/>

                                                    <!-- ADAPTER -->
                                                    <StackPanel Grid.Column="2" Spacing="8" Margin="0,10,0,10">
                                                          <TextBlock x:Name="lblAdapter" Text="ADAPTER" FontSize="10" FontWeight="Bold"
                                                                   Foreground="#8B949E" LetterSpacing="1" Margin="0,0,0,4"/>
                                                        <!-- TCP -->
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="TCP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbTcpAdapter" Width="150" MinHeight="26"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Height="26" Padding="8,0"
                                                                      VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"/>
                                                        </StackPanel>
                                                        <!-- UDP -->
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="UDP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbUdpAdapter" Width="150" MinHeight="26"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Height="26" Padding="8,0"
                                                                      VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <!-- Horizontal Separator 2 -->
                                        <Border Grid.Row="3" Height="1" Background="#2D3748" HorizontalAlignment="Stretch" Margin="0,0,0,0"/>

                                        <!-- CUSTOM PROXY -->
                                        <Grid Grid.Row="4" Margin="12,8,12,7" ColumnDefinitions="Auto, *">
                                            <TextBlock x:Name="lblCustomProxy" Grid.Column="0" Text="CUSTOM PROXY" FontSize="10" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Grid Grid.Column="1" Height="29" ColumnDefinitions="*,Auto">
                                                <ComboBox x:Name="cbCustomProxy" Grid.Column="0" Classes="customProxy" IsEditable="True"
                                                          SelectedIndex="-1" MinHeight="24" Height="24" Margin="0"
                                                          FontFamily="Consolas" FontSize="10" Padding="8,5,28,3"
                                                          Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4,0,0,4"
                                                          VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                          PlaceholderText="vless:// / vmess:// / sing-box JSON"
                                                          ToolTip.Tip="Type or paste a config, or pick a previously saved one from the arrow. Set a protocol's routing to CUSTOM PROXY to use it."
                                                          SelectionChanged="CustomProxySaved_SelectionChanged"/>
                                                    <Grid Grid.Column="1" Height="24" VerticalAlignment="Center" ColumnDefinitions="55,55,28">
                                                    <Border Grid.Column="0" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="0,1,1,1" CornerRadius="0" MinHeight="24">
                                                        <Button x:Name="btnCustomProxyPing" Content="PING" Click="CustomProxyPing_Click" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                        </Button>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="0,1,1,1" CornerRadius="0" MinHeight="24">
                                                        <Button x:Name="btnCustomProxySave" Content="SAVE" Click="CustomProxySave_Click" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                        </Button>
                                                    </Border>
                                                    <Border Grid.Column="2" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="0,1,1,1" CornerRadius="0,4,4,0" MinHeight="24">
                                                        <Button x:Name="btnCustomProxyDelete" Click="CustomProxyDelete_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0" Padding="0" ToolTip.Tip="Remove the config in the box from the saved list">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="12" Height="12" Foreground="#E53E3E"/>
                                                        </Button>
                                                    </Border>
                                                    </Grid>
                                            </Grid>
                                        </Grid>

                                        <!-- Horizontal Separator 3 -->
                                        <Border Grid.Row="5" Height="1" Background="#2D3748" HorizontalAlignment="Stretch"/>

                                        <!-- CONNECTION REGION -->
                                        <Grid Grid.Row="6" Margin="12,10,12,10" ColumnDefinitions="Auto, *">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="lblConnectionRegion" Text="CONNECTION REGION" FontSize="10" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lblConnectionRegionWarning" Text="Choosing a region might not work on all programs." FontSize="8" Foreground="#8B949E" Opacity="0.7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="cbRegion" SelectedIndex="0" Width="150" MinHeight="26"
                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                      FontSize="10" Height="26" Padding="8,0"
                                                      VerticalContentAlignment="Center" HorizontalAlignment="Right" CornerRadius="4"></ComboBox>
                                        </Grid>

                                        </Grid>
                                      </Border>
                                </Border>
                                <!-- The Default-Rule Editor (adapters) -->
                                <Border x:Name="panDefaultEditor" MaxHeight="0" Opacity="0" ClipToBounds="True">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                        </Transitions>
                                    </Border.Transitions>
                                    <Border Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8">
                                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                                            <Grid Grid.Row="0" ColumnDefinitions="16, Auto, Auto, Auto, 16, Auto, Auto, Auto, *" Margin="6,0,6,0" MinHeight="120">
                                                <LayoutTransformControl Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        UseRenderTransform="False">
                                                    <LayoutTransformControl.LayoutTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </LayoutTransformControl.LayoutTransform>
                                                    <TextBlock x:Name="lblDefaultRoutingHeader" Text="ROUTING" FontSize="10" FontWeight="Bold"
                                                               Foreground="#8B949E" LetterSpacing="1"/>
                                                </LayoutTransformControl>
                                                <Border Grid.Column="1" Width="1" Background="#2D3748" Margin="6,0,6,0"/>
                                                <!-- Routing combos -->
                                                <StackPanel x:Name="panDefaultRouting" Grid.Column="2" Spacing="8" Margin="5,0,5,0" VerticalAlignment="Center">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="TCP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbDefaultTcpRouting" Width="150" MinHeight="26" Height="26"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Padding="8,0" VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"
                                                                      SelectionChanged="DefaultRouting_SelectionChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="UDP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbDefaultUdpRouting" Width="150" MinHeight="26" Height="26"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Padding="8,0" VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"
                                                                      SelectionChanged="DefaultRouting_SelectionChanged"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                <Border Grid.Column="3" Width="1" Background="#2D3748" Margin="6,0,6,0"/>
                                                <LayoutTransformControl Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        UseRenderTransform="False">
                                                    <LayoutTransformControl.LayoutTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </LayoutTransformControl.LayoutTransform>
                                                    <TextBlock x:Name="lblDefaultAdapterHeader" Text="ADAPTER" FontSize="10" FontWeight="Bold"
                                                               Foreground="#8B949E" LetterSpacing="1"/>
                                                </LayoutTransformControl>
                                                <Border Grid.Column="5" Width="1" Background="#2D3748" Margin="6,0,6,0"/>
                                                <!-- Adapter combos -->
                                                <StackPanel Grid.Column="6" Spacing="8" Margin="5,0,5,0" VerticalAlignment="Center">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="TCP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbDefaultTcpAdapter" Width="150" MinHeight="26" Height="26"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Padding="8,0" VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="UDP" FontSize="9" FontWeight="SemiBold" Foreground="#606870" HorizontalAlignment="Left"/>
                                                            <ComboBox x:Name="cbDefaultUdpAdapter" Width="150" MinHeight="26" Height="26"
                                                                      Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                                      FontSize="10" Padding="8,0" VerticalContentAlignment="Center"
                                                                      HorizontalAlignment="Left" CornerRadius="4"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                <Border Grid.Column="7" Width="1" Background="#2D3748" Margin="6,0,6,0"/>
                                                <Border Grid.Column="8" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1"
                                                        CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Vertical">
                                                        <Button x:Name="btnDefaultRestore" Content="RESTORE DEFAULTS" Click="DefaultRestore_Click"
                                                                FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                                Padding="15,0" Height="26" Cursor="Hand" BorderThickness="0" CornerRadius="4,4,0,0">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                        </Button>
                                                        <Border Height="1" Background="#2D3748"/>
                                                        <Button x:Name="btnDefaultScanAdapters" Content="SCAN ADAPTERS" Click="BtnScanAdapters_Click"
                                                                FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                                Padding="15,0" Height="26" Cursor="Hand" BorderThickness="0" CornerRadius="0,0,4,4">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <!-- Horizontal Separator -->
                                            <Border Grid.Row="1" Height="1" Background="#2D3748" HorizontalAlignment="Stretch"/>
                                            <Grid Grid.Row="2" Margin="12,8,12,7" ColumnDefinitions="Auto, *">
                                                <TextBlock x:Name="lblDefaultCustomProxy" Grid.Column="0" Text="CUSTOM PROXY" FontSize="10" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Grid Grid.Column="1" Height="29" ColumnDefinitions="*,Auto">
                                                    <ComboBox x:Name="cbDefaultCustomProxy" Grid.Column="0" Classes="customProxy" IsEditable="True"
                                                              SelectedIndex="-1" MinHeight="24" Height="24" Margin="0"
                                                              FontFamily="Consolas" FontSize="10" Padding="8,5,28,3"
                                                              Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4,0,0,4"
                                                              VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                              PlaceholderText="vless:// / vmess:// / sing-box JSON"
                                                              ToolTip.Tip="Type or paste a config, or pick a previously saved one from the arrow. Set a protocol's routing to CUSTOM PROXY to use it."
                                                              SelectionChanged="CustomProxySaved_SelectionChanged"/>
                                                        <Grid Grid.Column="1" Height="24" VerticalAlignment="Center" ColumnDefinitions="55,55,28">
                                                            <Border Grid.Column="0" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="0,1,1,1" CornerRadius="0" MinHeight="24">
                                                                <Button x:Name="btnDefaultCustomProxyPing" Content="PING" Click="CustomProxyPing_Click" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                            <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                            <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                </Button>
                                                            </Border>
                                                            <Border Grid.Column="1" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="0,1,1,1" CornerRadius="0" MinHeight="24">
                                                                <Button x:Name="btnDefaultCustomProxySave" Content="SAVE" Click="CustomProxySave_Click" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0" Padding="0">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                            <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                            <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                </Button>
                                                            </Border>
                                                            <Border Grid.Column="2" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="0,1,1,1" CornerRadius="0,4,4,0" MinHeight="24">
                                                                <Button x:Name="btnDefaultCustomProxyDelete" Click="CustomProxyDelete_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0" Padding="0" ToolTip.Tip="Remove the config in the box from the saved list">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                            <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="12" Height="12" Foreground="#E53E3E"/>
                                                                </Button>
                                                            </Border>
                                                        </Grid>
                                                </Grid>
                                            </Grid>

                                            <!-- Horizontal Separator -->
                                            <Border Grid.Row="3" Height="1" Background="#2D3748" HorizontalAlignment="Stretch"/>
                                            <!-- Bottom bar: title + submit/cancel -->
                                            <Grid Grid.Row="4" Margin="12,10,12,10" ColumnDefinitions="*, Auto">
                                                <TextBlock x:Name="lblDefaultEditorHeader" Grid.Column="0" Text="DISCORD" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" LetterSpacing="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <Border Grid.Column="1" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Height="26">
                                                    <Grid ColumnDefinitions="Auto, 1, Auto">
                                                        <Button x:Name="btnDefaultSubmit" Grid.Column="0" Content="SUBMIT" Click="DefaultSubmit_Click"
                                                                FontSize="10" FontWeight="Bold" Foreground="#E2E8F0" Background="Transparent"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                                Padding="24,0" Height="26" Cursor="Hand" BorderThickness="0" CornerRadius="4,0,0,4">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                        </Button>
                                                        <Border Grid.Column="1" Background="#2D3748"/>
                                                        <Button x:Name="btnDefaultCancel" Grid.Column="2" Content="CANCEL" Click="DefaultCancel_Click"
                                                                FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                                Padding="24,0" Height="26" Cursor="Hand" BorderThickness="0" CornerRadius="0,4,4,0">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Border>

                            </StackPanel>

                            </Border>

                            <Border Height="43"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Panel Margin="1" ClipToBounds="True">
                    <Border x:Name="panSearchBarShadow" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Margin="6,6,6,0" Height="45" CornerRadius="6" IsHitTestVisible="False" Opacity="0"
                            Background="#FF000000" BoxShadow="0 6 18 0 #E6000000">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Border x:Name="panSearchBar" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Margin="6,6,6,0" Height="45" Classes="hoverBox" Background="#FF000000"
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="10,8">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBox x:Name="txtSearch" Width="100" Height="24" MinHeight="24" VerticalAlignment="Center" FontSize="10" Padding="8,0" VerticalContentAlignment="Center" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Foreground="#A0AEC0" TextChanged="Search_TextChanged"/>
                            <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Width="12" Height="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Live rule telemetry -->
                        <controls:OverlayStatsCluster x:Name="overlayStatsCluster" Grid.Column="1" VerticalAlignment="Center"/>

                        <!-- Right: filter -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <PathIcon Data="M14,12V19.88C14.04,20.18 13.94,20.5 13.71,20.71C13.32,21.1 12.69,21.1 12.3,20.71L10.29,18.7C10.06,18.47 9.96,18.16 10,17.87V12H9.97L4.21,4.62C3.87,4.19 3.95,3.56 4.38,3.22C4.57,3.08 4.78,3 5,3V3H19V3C19.22,3 19.43,3.08 19.62,3.22C20.05,3.56 20.13,4.19 19.79,4.62L14.03,12H14Z" Width="12" Height="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cbFilter" Classes="filterCombo" SelectedIndex="0" Width="100" Height="24" MinHeight="24" FontSize="10" FontWeight="SemiBold" Padding="8,0" VerticalContentAlignment="Center" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" SelectionChanged="Filter_SelectionChanged">
                                <ComboBoxItem x:Name="cbiFilterAll" Content="All" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBoxItem x:Name="cbiFilterGames" Content="Games" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBoxItem x:Name="cbiFilterLaunchers" Content="Launchers" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBoxItem x:Name="cbiFilterOther" Content="Other" FontSize="10" FontWeight="SemiBold"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
                </Panel>

                <StackPanel x:Name="panOverlayBottomBar" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13">
                    <StackPanel.Transitions>
                        <Transitions>
                            <ThicknessTransition Property="Margin" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                        </Transitions>
                    </StackPanel.Transitions>

                    <Panel>
                        <Border x:Name="panConnectShadow" Classes="shadowCarrier"/>

                        <Border x:Name="panConnectBox" Classes="floatBox connectBox" Padding="0"
                                ClipToBounds="True" Cursor="Hand"
                                PointerPressed="ConnectBoxPress" PointerReleased="ConnectBoxRelease"
                                PointerCaptureLost="ConnectBoxCaptureLost">
                            <Panel x:Name="panConnectBoxInner" MinHeight="17" MinWidth="104" RenderTransformOrigin="50%,50%">
                                <Panel.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Panel.RenderTransform>
                                <Panel.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.075"/>
                                    </Transitions>
                                </Panel.Transitions>
                                <Border CornerRadius="6,0,0,6" ClipToBounds="True" IsHitTestVisible="False"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border x:Name="panOverlayConnectFill" Background="{DynamicResource ThemeGlowBrush}" Opacity="0"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            RenderTransformOrigin="0%,50%">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0" ScaleY="1"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <Border x:Name="panConnectBoxPress" Background="{DynamicResource ButtonBackgroundPressed}" Opacity="0"
                                        CornerRadius="5" IsHitTestVisible="False"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <TextBlock x:Name="txtOverlayConnect" Text="CONNECT" FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                                           Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtOverlayConnectConnected" Text="CONNECTED" FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                                           Foreground="{DynamicResource ThemeSuccessGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0" IsHitTestVisible="False"/>
                            </Panel>
                        </Border>
                    </Panel>

                    <Border Classes="floatBox">
                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                            <Button x:Name="btnOverlaySplitRegular" Classes="optBtn" Click="OverlaySplitTunnel_Click" Padding="9,3" CornerRadius="4,0,0,4">
                                <TextBlock x:Name="lblOverlayRegular" Text="REGULAR" FontSize="9" FontWeight="Bold" LetterSpacing="0.5"/>
                            </Button>
                            <Button x:Name="btnOverlaySplitInclusive" Classes="optBtn" Click="OverlaySplitTunnel_Click" Padding="9,3" CornerRadius="0,4,4,0">
                                <TextBlock x:Name="lblOverlayInclusive" Text="INCLUSIVE" FontSize="9" FontWeight="Bold" LetterSpacing="0.5"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Classes="floatBox">
                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                            <Button x:Name="btnMasterOn" Classes="optBtn" Click="MasterPill_Click" Padding="9,3" CornerRadius="4,0,0,4">
                                <TextBlock x:Name="lblMasterOn" Text="ON" FontSize="9" FontWeight="Bold" LetterSpacing="0.5"/>
                            </Button>
                            <Button x:Name="btnMasterOff" Classes="optBtn" Click="MasterPill_Click" Padding="9,3" CornerRadius="0,4,4,0">
                                <TextBlock x:Name="lblMasterOff" Text="OFF" FontSize="9" FontWeight="Bold" LetterSpacing="0.5"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border x:Name="panApplyChangesBox" Classes="floatBox"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <Button x:Name="btnApplyChanges" Click="ApplyChanges_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" CornerRadius="4" Padding="9,3"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock x:Name="txtApplyChanges" Text="APPLY CHANGES" FontSize="9" FontWeight="Bold" LetterSpacing="0.5" Foreground="#E2E8F0"/>
                        </Button>
                    </Border>
                </StackPanel>


                </Panel>
            </Grid>
</UserControl>
