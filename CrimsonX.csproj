<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\CrimsonX.ico</ApplicationIcon>
    <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!-- Assembly & App Details -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Company>RichTiTAN</Company>
    <Authors>RichTiTAN</Authors>
    <Product>CrimsonX</Product>
    <Description>an advanced proxy client for Windows</Description>
    <Copyright>Copyright © 2026 RichTiTAN</Copyright>
  <EnableNETAnalyzers>false</EnableNETAnalyzers><NoWarn>CS8600;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625;CS0414;SYSLIB1045;SYSLIB1054;$(NoWarn);CA2249;CA1305;CA1310;CA1861;CA1845;CA2201;CA1001;CA1822;CA1852;CA1847</NoWarn></PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />

    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
