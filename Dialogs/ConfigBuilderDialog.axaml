<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:CrimsonX.Dialogs"
        x:Class="CrimsonX.Dialogs.ConfigBuilderDialog"
        x:DataType="dialogs:ConfigBuilderDialog"
        Width="420" SizeToContent="Height"
        CanResize="False" CanMinimize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        KeyDown="Dialog_KeyDown">

    <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
        </LayoutTransformControl.LayoutTransform>
        <ScrollViewer MaxHeight="620">
            <StackPanel Margin="25" Spacing="6">

                <TextBlock x:Name="lblBuilderProtocol" Text="PROTOCOL" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" LetterSpacing="1"/>
                <ComboBox x:Name="cmbBuilderProtocol" Height="30" HorizontalAlignment="Stretch"
                          Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4"
                          Foreground="#E2E8F0" FontSize="12"/>

                <StackPanel x:Name="panBuilderFields" Spacing="0" Margin="0,4,0,0"/>

                <TextBlock x:Name="lblBuilderError" FontSize="11" Foreground="#F87171" TextWrapping="Wrap" IsVisible="False" Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                    <Button x:Name="btnBuilderSave" Click="Save_Click"
                            Background="#3A3F44" Foreground="#E2E8F0" FontWeight="Bold" Padding="20,6"
                            FontSize="11" Cursor="Hand" CornerRadius="4" Content="SAVE">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="btnBuilderCancel" Click="Cancel_Click"
                            Background="#2D3748" Foreground="#A0AEC0" Padding="20,6"
                            FontSize="11" Cursor="Hand" CornerRadius="4" Content="CANCEL">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </LayoutTransformControl>
</Window>
