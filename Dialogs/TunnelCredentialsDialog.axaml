<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:CrimsonX.Dialogs"
        x:Class="CrimsonX.Dialogs.TunnelCredentialsDialog"
        x:DataType="dialogs:TunnelCredentialsDialog"
        Width="440" SizeToContent="Height"
        CanResize="False" CanMinimize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        KeyDown="Dialog_KeyDown">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="25">

        <TextBlock x:Name="lblTunnelTitle" Grid.Row="0" FontWeight="Bold" FontSize="15"
                   Margin="0,0,0,6" Foreground="#E2E8F0" TextWrapping="Wrap"/>

        <TextBlock x:Name="lblTunnelSub" Grid.Row="1" FontSize="12" Foreground="#8B949E"
                   Margin="0,0,0,16" TextWrapping="Wrap" LineHeight="18" MaxWidth="390"/>

        <TextBlock x:Name="lblTunnelUser" Grid.Row="2" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                   Foreground="#A0AEC0" Margin="0,0,0,4"/>

        <TextBox x:Name="txtTunnelUser" Grid.Row="3" Height="28" FontFamily="Consolas" FontSize="12"
                 Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4"
                 Foreground="#E2E8F0" Padding="8,4" VerticalContentAlignment="Center"
                 Margin="0,0,0,12"/>

        <TextBlock x:Name="lblTunnelPass" Grid.Row="4" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                   Foreground="#A0AEC0" Margin="0,0,0,4"/>

        <Grid Grid.Row="5" RowDefinitions="Auto,Auto">
            <TextBox x:Name="txtTunnelPass" Grid.Row="0" Height="28" FontFamily="Consolas" FontSize="12"
                     PasswordChar="●"
                     Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4"
                     Foreground="#E2E8F0" Padding="8,4" VerticalContentAlignment="Center"/>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
                <CheckBox x:Name="chkTunnelRemember" Grid.Column="0" FontSize="12" Foreground="#A0AEC0"
                          VerticalAlignment="Center" RenderTransformOrigin="0%,50%"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="btnTunnelOk" Click="Ok_Click"
                            Background="#3A3F44" Foreground="#E2E8F0" FontWeight="Bold" Padding="20,6"
                            FontSize="11" Cursor="Hand" CornerRadius="4">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="btnTunnelCancel" Click="Cancel_Click"
                            Background="#2D3748" Foreground="#A0AEC0" Padding="20,6"
                            FontSize="11" Cursor="Hand" CornerRadius="4">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
